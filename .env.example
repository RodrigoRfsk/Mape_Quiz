# Tanto o Vite (client) quanto o dotenv (server) leem este arquivo a partir
# da RAIZ do projeto. Copie para `.env` e ajuste os valores.

# ──────────────────────────────────────────────────────────────
# Client (Vite) — variáveis de build (prefixo VITE_)
# ──────────────────────────────────────────────────────────────
# Endpoint da API (Express) que recebe e persiste os leads.
VITE_API_URL="http://localhost:3001/api/leads"

# ──────────────────────────────────────────────────────────────
# Server (Express)
# ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Origem do frontend permitida pelo CORS. Em dev é o Vite (localhost:3000).
# Em produção, deixe em branco se o servidor servir o client no mesmo domínio.
CLIENT_URL="http://localhost:3000"

# Conexão PostgreSQL — estes valores batem com o docker-compose.yml deste repo.
# Formato: postgres://[user]:[senha]@[host]:[porta]/[database]
DATABASE_URL="postgres://admin:Jfafcuxnd29@localhost:5432/mape_quiz"

# Orquestrador de marketing (n8n): o backend dispara o lead já validado e
# classificado para esta URL após persistir no banco. O fluxo lê o campo
# "profile" (A/B/C) para acionar a cadência de e-mails/mensagens.
# Deixe em branco para desativar (o backend apenas loga um aviso e segue).
N8N_WEBHOOK_URL=""
