# Client Configuration
# Endpoint da API (Express) que recebe e persiste os leads.
VITE_API_URL="http://localhost:3001/api/leads"

# Server Configuration
# Orquestrador de marketing (n8n): o backend dispara o lead já validado e
# classificado para esta URL após persistir no banco. O fluxo lê o campo
# "profile" (A/B/C) para acionar a cadência de e-mails/mensagens.
N8N_WEBHOOK_URL=""