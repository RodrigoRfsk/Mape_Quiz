# Server Configuration
PORT=3001
NODE_ENV=development

# Security / CORS
# Determines which frontend origin is allowed to communicate with this API
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# Format: postgres://[user]:[password]@[host]:[port]/[database_name]
# Replace this with your actual connection string (Local, Supabase, Neon, etc.)
DATABASE_URL="postgres://admin:postgres@localhost:5432/mape_quiz"